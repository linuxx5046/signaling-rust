{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource that scrapes signaling-rust's /metrics endpoint (see metrics-addons/prometheus.yml)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "title": "signaling-rust",
  "description": "Connections, message throughput, Redis timing and process health for the Radix signaling-rust server.",
  "tags": ["signaling-rust", "radix", "webrtc-signaling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connected clients",
      "description": "signaling_server_connected_clients — current count of open WebSocket connections (Wallet + Extension combined).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [
        { "expr": "signaling_server_connected_clients", "legendFormat": "connected", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Process uptime",
      "description": "Time since the signaling-rust process started (process_start_time_seconds).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "time() - process_start_time_seconds", "legendFormat": "uptime", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU usage",
      "description": "rate(process_cpu_seconds_total[1m]) as a percentage of one core.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 85 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[1m]) * 100", "legendFormat": "cpu %", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memory (RSS)",
      "description": "process_resident_memory_bytes — actual physical memory in use.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Message throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Incoming vs outgoing messages (msg/s)",
      "description": "signaling_server_incoming_messages and signaling_server_outgoing_messages, as per-second rates.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(signaling_server_incoming_messages[1m])", "legendFormat": "incoming", "refId": "A" },
        { "expr": "rate(signaling_server_outgoing_messages[1m])", "legendFormat": "outgoing", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis publish rate (msg/s)",
      "description": "signaling_server_publish_messages — successful PUBLISH operations to Redis per second.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(signaling_server_publish_messages[1m])", "legendFormat": "publish", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Redis latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis operation latency (ms, last observed)",
      "description": "signaling_server_redis_{get,set,delete,publish,subscribe}_time — these are last-observed-value gauges, not histograms.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "signaling_server_redis_get_time", "legendFormat": "SMEMBERS (get)", "refId": "A" },
        { "expr": "signaling_server_redis_set_time", "legendFormat": "SADD+EXPIRE (set)", "refId": "B" },
        { "expr": "signaling_server_redis_delete_time", "legendFormat": "SREM (delete)", "refId": "C" },
        { "expr": "signaling_server_redis_publish_time", "legendFormat": "PUBLISH", "refId": "D" },
        { "expr": "signaling_server_redis_subscribe_time", "legendFormat": "SUBSCRIBE setup", "refId": "E" }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Process health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "process_open_fds vs process_max_fds. Each WebSocket connection plus its Redis subscription consumes file descriptors — important headroom to watch near 6000 concurrent connections.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "process_open_fds", "legendFormat": "open", "refId": "A" },
        { "expr": "process_max_fds", "legendFormat": "max (ulimit -n)", "refId": "B" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Threads",
      "description": "process_threads — Tokio runtime OS thread count.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "process_threads", "legendFormat": "threads", "refId": "A" }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "subscribe_messages (known dead metric)",
      "description": "signaling_server_subscribe_messages — declared but never incremented, by design, to match the original server's behavior. Expected to always read 0. If this ever shows non-zero, something changed unexpectedly.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "signaling_server_subscribe_messages", "legendFormat": "subscribe_messages", "refId": "A" }
      ]
    }
  ]
}

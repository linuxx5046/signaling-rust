# Copy this file to .env and fill in real values. Never commit the real .env.

REDIS_HOST_PUB=127.0.0.1
REDIS_HOST_SUBS=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# LOG_LEVEL is numeric per the original's contract — check your logging
# module before picking a value.
LOG_LEVEL=3

PORT=8080
HTTP_PORT=8081

RATE_LIMIT_MESSAGES=100
RATE_LIMIT_MS=1000
HEARTBEAT_INTERVAL_MS=30000
